# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# 环境变量
.env
.env.local

# 数据库与向量库
*.db
*.db-wal
*.db-shm
# LangGraph 的 checkpoint 库：与任务库同目录、同生命周期，属于运行时副产物
# （*.db 匹配不到 .db.checkpoints 这个后缀，必须显式写）
*.db.checkpoints
*.db.checkpoints-wal
*.db.checkpoints-shm
*.sqlite3
data/chroma/
# 运行时知识库。用 `docs*` 而不是 `docs/`：换语料做验证时会另建
# data/docs_real/ 之类，那同样是运行时副本，不该进版本库。
# 项目自带的两套语料在仓库根的 sample-corpus/ 与 real-corpus/，那两个要入库。
data/docs*/
data/output/
# LLM 录制缓存：默认不入库（模型产出物、体积随主题增长）。
# 若想让全队/CI 离线回放同一批结果，可显式 `git add -f data/llm_cache/<kk>/*.json`
data/llm_cache/
# 向量索引：由语料 + embedding 模型即时重建，属于运行时副产物。
# 默认落 data/vector_index；显式写出来是因为上面只有 data/docs*/ 与 data/llm_cache/，
# 漏了它会把几百 KB 的浮点数组提交进版本库，且换语料后必然过期。
data/vector_index/

# 前端
node_modules/
dist/
.vite/
*.local

# 日志与临时文件
logs/
*.log
tmp/
.DS_Store

# 评测产物。明细（cases/*.json、results.json）体积大且可重跑生成，不入库；
# 但 **report.md 是结论摘要，必须入库** —— README / 验收文档引用的每个数字
# 都要能在仓库里查到，否则"这个数字哪来的"无法回答，读者只能选择相信或不相信。
#
# 注意 gitignore 的一条规则：父目录被排除后，git 就不会再进入它检查子文件，
# 所以单写 `!eval/results/*/report.md` 是无效的 —— 必须先用 `*` 重新包含
# 中间目录，再放行目标文件。
eval/results/*
!eval/results/*/
eval/results/*/*
!eval/results/*/report.md

# 编辑器
.idea/
.vscode/
*.swp

# 会话记忆（agent 内部工作日志）。只存在于本地，不进版本库。
.workbuddy/

# 临时提交信息文件（git commit -F 用的）
_msg*.txt
