# ===== 数据库 =====
# 阶段一默认 SQLite：留空即用 <repo>/data/reportflow.db，零准备即可跑
# 生产切 MySQL 只需改成：mysql+pymysql://user:pass@host:3306/reportflow
DATABASE_URL=

# ===== 编排 =====
# 同时在跑的节点数上限。5 章任务在 3 下呈现 3+2 两波，便于观察并行
MAX_CONCURRENCY=3
# 单节点执行超时（秒）
NODE_TIMEOUT=120
# 单节点失败后的重试次数（总尝试次数 = 1 + MAX_RETRIES）
MAX_RETRIES=1
# 指数退避基数（秒），第 n 次重试等待 base * 2^(n-1)
RETRY_BACKOFF=1.0

# ===== LLM（阶段二启用） =====
# 填好后先跑 python -m app.cli doctor 验证连通性，再跑任务
# 任意 OpenAI 兼容接口均可：DeepSeek / 通义千问 / 智谱 / vLLM 自建 / Ollama
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL_PRIMARY=deepseek-chat
# 超时降级用，建议换一家厂商，避免同时不可用；留空则不降级
LLM_MODEL_FALLBACK=qwen-plus
# 同一模型的退避重试次数（429/超时/5xx）
LLM_MAX_RETRIES=2
LLM_BACKOFF=1.0
# 单次 LLM 请求超时（秒）。应小于 NODE_TIMEOUT，否则节点会被调度器先杀掉
LLM_TIMEOUT=60
# 示例单价（元/百万 token），仅用于成本归因。接真实厂商后按价目表改
LLM_PRICE_INPUT_PER_M=1.0
LLM_PRICE_OUTPUT_PER_M=3.0

# ===== 开发阶段的「零成本」模式 =====
# auto   = 命中本地录制缓存就回放（¥0、毫秒级、结果确定），未命中才真调模型
# replay = 只读缓存，绝不联网（没有 key 也能跑）
# record = 真调模型并把响应落盘（补录用）
# live   = 直连模型，不读不写缓存
# !!! 跑评测 / 演示 / 交付前必须改 live，否则会复用旧响应 !!!
LLM_MODE=auto
# 缓存目录，留空 = <repo>/data/llm_cache
LLM_CACHE_DIR=

# ===== 评测判官（与生成模型分离）=====
# 同一个模型给自己判卷会系统性偏向自己：C 组(带 Reviewer)的"通过"可能是自我认同。
# 换成同厂商另一个模型只是缓解；彻底消除要跨厂商，下面两种写法任选。
#
# 写法 A（同厂商，零成本起步）：
# LLM_JUDGE_MODEL=deepseek-v4-pro
#
# 写法 B（跨厂商，推荐；硅基流动托管 zai-org/GLM-5.3-Flash）
# LLM_JUDGE_BASE_URL=https://api.siliconflow.cn/v1
# LLM_JUDGE_MODEL=zai-org/GLM-5.3-Flash
# LLM_JUDGE_API_KEY=sk-你的硅基流动key
# 判官单价（元/百万 token）。跨厂商必须单独填，否则成本表会拿生成模型的价格硬套。
# GLM-5.3-Flash 官方价 $0.15/$0.50 每百万 token，约合：
# LLM_JUDGE_PRICE_INPUT_PER_M=1.07
# LLM_JUDGE_PRICE_OUTPUT_PER_M=3.55
LLM_JUDGE_MODEL=deepseek-v4-pro
LLM_JUDGE_BASE_URL=
LLM_JUDGE_API_KEY=
LLM_JUDGE_PRICE_INPUT_PER_M=
LLM_JUDGE_PRICE_OUTPUT_PER_M=
# Reviewer 打回上限（每章最多被打回几轮）
# Reviewer 是否进入写作循环。默认 false：评测显示循环内无收益却贵 49%，
# 改为导出时 `cli export --check` 一次性体检。
REVIEW_IN_PIPELINE=false
# 每章分配不重叠的文档预算。默认 false：实测重复率仅 −1.2pp（不显著），成本 +20%。
# 语料规模上来（每主题 ≥30 篇相关文档）再考虑打开。
DOC_BUDGET=false
MAX_REVIEW_RETRIES=2

# ===== 知识库 =====
# 放 .md/.txt 即可；留空默认 <repo>/data/docs
DOCS_DIR=

# ===== 检索（混合检索） =====
# bm25   = 关键词检索。零依赖、结果可复现，是历史评测基线的口径
# vector = 纯向量检索（需要 EMBEDDING_API_KEY）
# hybrid = BM25 + 向量，RRF 融合（需要 EMBEDDING_API_KEY）
# 默认 bm25：不让历史 40 主题基线因为新增检索方式而漂移
RETRIEVAL_MODE=bm25
# 任意 OpenAI 兼容的 /embeddings 端点均可（硅基流动 / 智谱 / 自建 vLLM）
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# 留空时 hybrid/vector 自动降级为 bm25，不会报错也不会联网
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_TIMEOUT=30
# 单请求批量条数。多数端点上限 32~128，32 最保守
EMBEDDING_BATCH_SIZE=32
# RRF 平滑常数，论文与工业界默认 60
RRF_K=60
# 向量索引落盘目录，留空 = <repo>/data/vector_index（已被 .gitignore 忽略）
VECTOR_INDEX_DIR=

# ===== 缓存（阶段四启用） =====
# 单实例 + 轮询调度的设计下，Redis 不参与正确性，仅作跨进程进度缓存
# REDIS_URL=redis://localhost:6379/0

# ===== 日志 =====
LOG_LEVEL=INFO
